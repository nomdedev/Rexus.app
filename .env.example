# Rexus.app - Environment Configuration Template
# Copia este archivo a .env y configura los valores apropiados

# ===========================================
# ENTORNO
# ===========================================
NODE_ENV=development
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# ===========================================
# BASE DE DATOS
# ===========================================
DB_SERVER=localhost
DB_PORT=1433
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_USERNAME=sa
DB_PASSWORD=your_secure_password_here
DB_TRUSTED_CONNECTION=no

# Bases de datos individuales
DB_USERS=users
DB_INVENTARIO=inventario
DB_AUDITORIA=auditoria

# Pool de conexiones
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ===========================================
# SEGURIDAD
# ===========================================
# Clave secreta para la aplicación (mínimo 32 caracteres, generada con secrets.token_urlsafe(32))
SECRET_KEY=generate_with_python_-_c_import_secrets_print_secrets_token_urlsafe_32

# Clave para JWT tokens (mínimo 32 caracteres)
JWT_SECRET_KEY=generate_with_python_-_c_import_secrets_print_secrets_token_urlsafe_32

# Tiempo de expiración de tokens (en segundos)
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=86400

# Clave de encriptación (AES-256, 32 bytes hex)
ENCRYPTION_KEY=generate_with_python_-_c_import_os_print_os_urandom_32_hex

# Algoritmo de hash para contraseñas (bcrypt, argon2, pbkdf2)
PASSWORD_HASH_ALGORITHM=bcrypt

# Política de contraseñas
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=false
PASSWORD_UPPERCASE_REQUIRED=true

# Session
SESSION_TIMEOUT=3600
MAX_SESSIONS_PER_USER=3

# Rate limiting
MAX_LOGIN_ATTEMPTS=3
LOGIN_LOCKOUT_DURATION=300

# ===========================================
# SECRETS MANAGEMENT
# ===========================================
# Usa HashiCorp Vault para secrets en producción
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=
VAULT_MOUNT=secret

# Cifrado local (fallback)
SECRETS_MASTER_KEY=generate_with_python_-_c_import_os_print_os_urandom_32_hex
SECRETS_STORAGE_PATH=./config/secrets.enc
SECRETS_CACHE_TTL=300

# ===========================================
# CACHE (Redis)
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAXMEMORY=256mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# TTL de cache (segundos)
CACHE_DEFAULT_TTL=3600
CACHE_SESSION_TTL=1800

# ===========================================
# MONITOREO
# ===========================================
# Prometheus
PROMETHEUS_ENABLED=false
PROMETHEUS_PORT=8000

# Metrics
METRICS_ENABLED=true
METRICS_PATH=/metrics

# ===========================================
# LOGGING
# ===========================================
LOG_FORMAT=json
LOG_FILE=./logs/rexus.log
LOG_ROTATION_SIZE_MB=50
LOG_RETENTION_DAYS=30

# Sentry (error tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ===========================================
# ALERTAS
# ===========================================
# Email
ALERT_EMAIL_ENABLED=false
ALERT_SMTP_HOST=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USERNAME=alerts@rexus.app
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_FROM=alerts@rexus.app
ALERT_EMAIL_TO=devops@rexus.app

# Slack
ALERT_SLACK_WEBHOOK=
ALERT_SLACK_CHANNEL=#alerts
ALERT_SLACK_USERNAME=Rexus Alerts

# Webhook genérico
ALERT_WEBHOOK_URL=

# ===========================================
# API
# ===========================================
API_HOST=0.0.0.0
API_PORT=5000
API_WORKERS=4

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_METHODS=GET,POST,PUT,DELETE,PATCH
CORS_HEADERS=Content-Type,Authorization

# Rate limiting API
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=60

# ===========================================
# BACKUP
# ===========================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESS=true

# S3 Backup (opcional)
BACKUP_S3_ENABLED=false
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=

# ===========================================
# EMPRESA
# ===========================================
EMPRESA_NOMBRE=Mi Empresa
EMPRESA_RUC=
EMPRESA_DIRECCION=
EMPRESA_TELEFONO=
EMPRESA_EMAIL=

# ===========================================
# DESARROLLO
# ===========================================
# Hot reload
HOT_RELOAD=true

# Debug toolbar
DEBUG_TOOLBAR=false

# Profiling
PROFILING_ENABLED=false

# Test data
LOAD_TEST_DATA=false
