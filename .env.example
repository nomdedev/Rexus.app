# Archivo de ejemplo de variables de entorno para Rexus.app
# Copie este archivo como .env y configure sus valores reales

# Configuración de Base de Datos
REXUS_DB_SERVER=localhost
REXUS_DB_PORT=1433
REXUS_DB_NAME=rexus_db
REXUS_DB_USER=rexus_user
REXUS_DB_PASSWORD=su_password_seguro_aqui
REXUS_DB_TIMEOUT=30
REXUS_DB_POOL_SIZE=10

# Configuración de Email
REXUS_EMAIL_SMTP_SERVER=smtp.gmail.com
REXUS_EMAIL_SMTP_PORT=587
REXUS_EMAIL_USER=noreply@miempresa.com
REXUS_EMAIL_PASSWORD=su_password_email_aqui
REXUS_EMAIL_SSL=true

# Configuración del Sistema
REXUS_DEBUG=false
REXUS_LOG_LEVEL=INFO

# NOTA: Nunca commitee el archivo .env real al repositorio
# El archivo .env debe estar en .gitignore
