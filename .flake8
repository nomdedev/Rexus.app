[flake8]
exclude =
    .git,
    __pycache__,
    .pytest_cache,
    tests,
    scripts,
    examples,
    backups,
    reports,
    rexus_app.egg-info,
    .vscode,
    logs,
    cache,
    .claude,
    sql,
    resources,
    config,
    docs,
    *.pyc

max-line-length = 100
max-complexity = 12
ignore =
    E203,
    E501,
    W503,
    F401,
    C901

per-file-ignores =
    __init__.py:F401
