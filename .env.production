# Rexus.app - Production Environment
# IMPORTANTE: Los valores secrets deben venir de Vault o variables de entorno seguras
# NO almacenes secrets reales en este archivo

ENVIRONMENT=production
NODE_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# Base de datos (producción)
# Usar SecretsManager para password
DB_SERVER=production-db-server
DB_PORT=1433
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_USERNAME=rexus_app_user
DB_PASSWORD=  # Debe venir de VAULT o variable de entorno
DB_TRUSTED_CONNECTION=no

# Pool
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Secrets (producción - REQUERIDO Vault o SECRETS_MASTER_KEY)
SECRET_KEY=  # Debe venir de VAULT
JWT_SECRET_KEY=  # Debe venir de VAULT
ENCRYPTION_KEY=  # Debe venir de VAULT

# Vault Configuration
VAULT_ADDR=https://vault.internal.company.com
VAULT_TOKEN=  # Token de approle
SECRETS_MASTER_KEY=  # Fallback: clave maestra de 32 bytes hex

# Política de contraseñas (producción)
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=true
PASSWORD_UPPERCASE_REQUIRED=true

# Session (producción)
SESSION_TIMEOUT=1800
MAX_SESSIONS_PER_USER=2

# Rate limiting (producción)
MAX_LOGIN_ATTEMPTS=3
LOGIN_LOCKOUT_DURATION=900

# Redis (producción)
REDIS_HOST=redis.production.internal
REDIS_PORT=6379
REDIS_PASSWORD=  # Debe venir de VAULT
REDIS_MAXMEMORY=1gb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# Cache TTL (producción)
CACHE_DEFAULT_TTL=3600
CACHE_SESSION_TTL=900

# API (producción)
API_HOST=0.0.0.0
API_PORT=5000
API_WORKERS=8
CORS_ORIGINS=https://app.rexus.com
CORS_METHODS=GET,POST,PUT,DELETE,PATCH
CORS_HEADERS=Content-Type,Authorization
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=60

# Monitoreo (producción)
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=8000
METRICS_ENABLED=true
METRICS_PATH=/metrics

# Logging (producción)
LOG_FORMAT=json
LOG_FILE=/var/log/rexus/rexus.log
LOG_ROTATION_SIZE_MB=100
LOG_RETENTION_DAYS=90

# Sentry (producción)
SENTRY_DSN=  # Debe venir de VAULT
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Alertas (producción)
ALERT_EMAIL_ENABLED=true
ALERT_SMTP_HOST=smtp.company.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USERNAME=alerts@rexus.com
ALERT_SMTP_PASSWORD=  # Debe venir de VAULT
ALERT_EMAIL_FROM=alerts@rexus.com
ALERT_EMAIL_TO=devops@rexus.com,oncall@rexus.com

ALERT_SLACK_WEBHOOK=  # Debe venir de VAULT
ALERT_SLACK_CHANNEL=#alerts-prod
ALERT_SLACK_USERNAME=Rexus Prod Alerts

# JWT (producción)
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800

# Backups (producción)
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_PATH=/backups/rexus
BACKUP_RETENTION_DAYS=90
BACKUP_COMPRESS=true

# S3 Backup (producción)
BACKUP_S3_ENABLED=true
BACKUP_S3_BUCKET=rexus-backups-prod
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY=  # Debe venir de VAULT
BACKUP_S3_SECRET_KEY=  # Debe venir de VAULT
