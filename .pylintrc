[MASTER]
ignore=tests,scripts,examples,backups,reports,.pytest_cache,__pycache__,rexus_app.egg-info,.git,.vscode,logs,cache,.claude,sql,resources,config,docs

[REPORTS]
output-format=colorized
include-ids=yes
files-output=no

[MESSAGES CONTROL]
disable=C0114,C0115,C0116,R0903,R0912,R0915,W0613,W0703

[BASIC]
good-names=i,j,k,ex,Run,_,id,pk,db

[FORMAT]
max-line-length=100
indent-string='    '

[SIMILARITIES]
ignore-imports=yes
min-similarity-lines=6

[DESIGN]
max-args=8
max-locals=20
max-returns=8
max-branches=15
max-statements=60
max-parents=10

[IMPORTS]
allow-wildcard-with-all=no
