# Rexus.app - Development Environment
ENVIRONMENT=development
NODE_ENV=development
DEBUG=true
LOG_LEVEL=DEBUG

# Base de datos (desarrollo)
DB_SERVER=localhost
DB_PORT=1433
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_USERNAME=sa
DB_PASSWORD=DevPassword123!
DB_TRUSTED_CONNECTION=yes

# Secrets (desarrollo - usar SECRETS_MASTER_KEY para cifrado local)
SECRET_KEY=dev_secret_key_change_in_production_32chars
JWT_SECRET_KEY=dev_jwt_secret_key_change_in_production_32chars
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SECRETS_MASTER_KEY=dev_master_key_32_chars_long_at_least!!

# Redis (desarrollo)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# API (desarrollo)
API_HOST=127.0.0.1
API_PORT=5000
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Monitoreo (desarrollo)
PROMETHEUS_ENABLED=false
METRICS_ENABLED=true

# Backups (desarrollo)
BACKUP_ENABLED=false
