# Rexus.app - Staging Environment
# Ambiente de pre-producción para testing

ENVIRONMENT=staging
NODE_ENV=staging
DEBUG=false
LOG_LEVEL=INFO

# Base de datos (staging)
DB_SERVER=staging-db-server
DB_PORT=1433
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_USERNAME=rexus_staging_user
DB_PASSWORD=  # Debe venir de VAULT o variable de entorno
DB_TRUSTED_CONNECTION=no

# Secrets (staging)
SECRET_KEY=  # Debe venir de VAULT o generar uno nuevo
JWT_SECRET_KEY=  # Debe venir de VAULT o generar uno nuevo
ENCRYPTION_KEY=  # Debe venir de VAULT o generar uno nuevo

# Vault Configuration (staging)
VAULT_ADDR=https://vault.staging.company.com
VAULT_TOKEN=  # Token de approle
SECRETS_MASTER_KEY=  # Fallback: clave maestra

# Política de contraseñas (staging)
PASSWORD_MIN_LENGTH=10
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=true
PASSWORD_UPPERCASE_REQUIRED=true

# Session (staging)
SESSION_TIMEOUT=3600
MAX_SESSIONS_PER_USER=5

# Rate limiting (staging)
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=600

# Redis (staging)
REDIS_HOST=redis.staging.internal
REDIS_PORT=6379
REDIS_PASSWORD=  # Debe venir de VAULT
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# API (staging)
API_HOST=0.0.0.0
API_PORT=5000
API_WORKERS=4
CORS_ORIGINS=https://staging.rexus.com,http://localhost:3000
CORS_METHODS=GET,POST,PUT,DELETE,PATCH
CORS_HEADERS=Content-Type,Authorization

# Monitoreo (staging)
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=8000
METRICS_ENABLED=true

# Logging (staging)
LOG_FORMAT=json
LOG_FILE=/var/log/rexus/rexus.log
LOG_ROTATION_SIZE_MB=50
LOG_RETENTION_DAYS=30

# Sentry (staging)
SENTRY_DSN=  # Debe venir de VAULT
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.5

# Alertas (staging)
ALERT_EMAIL_ENABLED=true
ALERT_SMTP_HOST=smtp.company.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USERNAME=alerts@rexus.com
ALERT_SMTP_PASSWORD=  # Debe venir de VAULT
ALERT_EMAIL_FROM=alerts@rexus.com
ALERT_EMAIL_TO=dev-staging@rexus.com

ALERT_SLACK_WEBHOOK=  # Debe venir de VAULT
ALERT_SLACK_CHANNEL=#alerts-staging
ALERT_SLACK_USERNAME=Rexus Staging Alerts

# JWT (staging)
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=86400

# Backups (staging)
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 3 * * *
BACKUP_PATH=/backups/rexus-staging
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESS=true
